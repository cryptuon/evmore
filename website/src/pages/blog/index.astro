---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Blog' },
];

const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout
  title="EVMORE Blog"
  description="Articles about cryptocurrency mining, digital gold, blockchain technology, and the EVMORE ecosystem. Comparisons, guides, and analysis for miners and investors."
  seoKeywords={['cryptocurrency blog', 'mining articles', 'digital gold', 'EVMORE news', 'crypto analysis']}
>
  <Breadcrumbs items={breadcrumbs} />

  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-2">Blog</h1>
    <p class="text-gray-600 dark:text-gray-400 mb-8">
      Deep dives into cryptocurrency mining, digital gold economics, and blockchain technology.
    </p>

    <div class="flex flex-wrap gap-2 mb-8">
      {allTags.map((tag) => (
        <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300">
          {tag}
        </span>
      ))}
    </div>

    <div class="space-y-6">
      {posts.map((post) => (
        <a href={`/blog/${post.slug}/`} class="card p-6 block hover:border-primary-500 dark:hover:border-primary-500 transition-colors">
          <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-3">
            <div class="flex-1">
              <div class="flex flex-wrap gap-1.5 mb-2">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-700 dark:text-primary-300">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{post.data.title}</h2>
              <p class="text-sm text-gray-600 dark:text-gray-400">{post.data.description}</p>
            </div>
            <time class="text-sm text-gray-500 whitespace-nowrap" datetime={post.data.date.toISOString()}>
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </time>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
