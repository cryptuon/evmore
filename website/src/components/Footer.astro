---
const year = new Date().getFullYear();
---

<footer class="bg-white dark:bg-evmore-dark border-t border-gray-200 dark:border-gray-800 mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <div class="flex items-center gap-2 mb-4">
          <div class="w-8 h-8 bg-primary-500 rounded-lg flex items-center justify-center">
            <span class="text-lg font-bold text-gray-900">E</span>
          </div>
          <span class="text-lg font-bold text-gray-900 dark:text-white">EVMORE</span>
        </div>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          Fair-launch digital gold on Ethereum. ASIC-resistant KeccakCollision mining with a 21M supply cap.
        </p>
      </div>

      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Project</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/tokenomics/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Tokenomics</a></li>
          <li><a href="/whitepaper/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Whitepaper</a></li>
          <li><a href="/blog/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">Resources</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="https://docs.cryptuon.com/evmore" target="_blank" rel="noopener" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Documentation</a></li>
          <li><a href="https://github.com" target="_blank" rel="noopener" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">GitHub</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-semibold text-gray-900 dark:text-white mb-3">App</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/app/dashboard/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Dashboard</a></li>
          <li><a href="/app/mining/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Mining</a></li>
          <li><a href="/app/wallet/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Wallet</a></li>
          <li><a href="/app/bridge/" class="text-gray-600 hover:text-primary-600 dark:text-gray-400 dark:hover:text-primary-400">Bridge</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-800 text-center text-sm text-gray-500 dark:text-gray-400">
      &copy; {year} EVMORE. Fair-launch digital gold cryptocurrency. No premine, no ICO.
    </div>
  </div>
</footer>
